# @version 1.5.0
# @display 52x16
# @config topic text "MQTT Topic" default=""
# @config speed number "Wave & Bubble Speed (1-10)" default=3 min=1 max=10
# @config big_text select "Large Centered Text (ignores alignment)" default=no options=no,yes
# @config text_shadow select "Text Shadow" default=yes options=no,yes
# @config hide_full select "Hide when Full (100%)" default=no options=no,yes
# @config pos_x select "Horizontal Alignment" default=left options=left,center,right
# @config pos_y select "Vertical Alignment" default=top options=top,middle,bottom

import math
import json

class WaterLevel
  var current_topic
  var level
  var wave_phase
  var bubbles
  var big_font

  def init()
    self.current_topic = nil
    self.level = nil
    self.wave_phase = 0.0

    # 7 aufsteigende Luftbläschen mit gestaffeltem Startzyklus: [base_x, y_float, speed_factor, wobble_phase]
    # Gestaffelte Y-Werte über die volle Displayhöhe (16px) verhindern gleichzeitiges Spawnen
    self.bubbles = [
      [6.0,  15.0, 0.8, 0.0],
      [13.0, 17.3, 1.1, 1.2],
      [20.0, 19.6, 0.7, 2.4],
      [27.0, 21.9, 1.0, 3.6],
      [34.0, 24.2, 0.9, 4.8],
      [41.0, 26.5, 1.2, 5.5],
      [47.0, 28.8, 0.8, 1.8]
    ]

    # Große 5x10 Pixel Glyphen: 0-9, %, -
    var raw_glyphs = {
      '0': [0x0E, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0E],
      '1': [0x04, 0x0C, 0x14, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04, 0x1F],
      '2': [0x0E, 0x11, 0x01, 0x01, 0x02, 0x04, 0x08, 0x10, 0x10, 0x1F],
      '3': [0x0E, 0x11, 0x01, 0x01, 0x06, 0x01, 0x01, 0x01, 0x11, 0x0E],
      '4': [0x02, 0x06, 0x0A, 0x12, 0x12, 0x1F, 0x02, 0x02, 0x02, 0x02],
      '5': [0x1F, 0x10, 0x10, 0x1E, 0x01, 0x01, 0x01, 0x01, 0x11, 0x0E],
      '6': [0x0E, 0x11, 0x10, 0x10, 0x1E, 0x11, 0x11, 0x11, 0x11, 0x0E],
      '7': [0x1F, 0x01, 0x01, 0x02, 0x02, 0x04, 0x04, 0x08, 0x08, 0x08],
      '8': [0x0E, 0x11, 0x11, 0x11, 0x0E, 0x11, 0x11, 0x11, 0x11, 0x0E],
      '9': [0x0E, 0x11, 0x11, 0x11, 0x0F, 0x01, 0x01, 0x01, 0x11, 0x0E],
      '%': [0x19, 0x1A, 0x02, 0x04, 0x04, 0x08, 0x08, 0x0B, 0x13, 0x00],
      '-': [0x00, 0x00, 0x00, 0x00, 0x1F, 0x1F, 0x00, 0x00, 0x00, 0x00]
    }

    self.big_font = {}
    for k: raw_glyphs.keys()
      self.big_font[k] = raw_glyphs[k]
    end
    self.big_font[48] = raw_glyphs['0']
    self.big_font[49] = raw_glyphs['1']
    self.big_font[50] = raw_glyphs['2']
    self.big_font[51] = raw_glyphs['3']
    self.big_font[52] = raw_glyphs['4']
    self.big_font[53] = raw_glyphs['5']
    self.big_font[54] = raw_glyphs['6']
    self.big_font[55] = raw_glyphs['7']
    self.big_font[56] = raw_glyphs['8']
    self.big_font[57] = raw_glyphs['9']
    self.big_font[37] = raw_glyphs['%']
    self.big_font[45] = raw_glyphs['-']
  end

  def get_topic()
    var t = nil
    try
      if store.get("topic") != nil
        var val = str(store.get("topic"))
        if size(val) > 0
          t = val
        end
      end
    except ..
    end
    return t
  end

  def setup()
    self.current_topic = self.get_topic()
    if self.current_topic != nil && size(self.current_topic) > 0
      mqtt.subscribe(self.current_topic, / topic, payload -> self.on_mqtt(payload))
    end
  end

  def should_hide()
    try
      if store.get("hide_full") != nil
        var h = store.get("hide_full")
        var cfg_hide = (h == "yes" || h == "Yes" || h == "true" || h == true || h == 1 || h == "1")
        if cfg_hide && self.level != nil && (self.level >= 100.0 || int(self.level) >= 100)
          return true
        end
      end
    except ..
    end
    return false
  end

  def should_show()
    return !self.should_hide()
  end

  def on_mqtt(payload)
    var val = nil
    try
      var data = json.load(str(payload))
      if type(data) == 'map'
        if data.contains('percent')    val = real(data['percent'])
        elif data.contains('level')    val = real(data['level'])
        elif data.contains('value')    val = real(data['value'])
        elif data.contains('val')      val = real(data['val'])
        end
      else
        val = real(data)
      end
    except ..
      try
        val = real(payload)
      except ..
      end
    end

    if val != nil
      if val < 0.0   val = 0.0   end
      if val > 100.0 val = 100.0 end
      self.level = val
    end
  end

  # Hilfsfunktion: Dimmt eine Farbe um einen Faktor ab
  def dim_color(c, factor)
    var r = int(((c >> 16) & 0xFF) * factor)
    var g = int(((c >> 8) & 0xFF) * factor)
    var b = int((c & 0xFF) * factor)
    return (r << 16) | (g << 8) | b
  end

  # Hilfsfunktion: Mischt zwei Farben stufenlos (Subpixel-Anti-Aliasing)
  def blend_colors(c_bg, c_fg, alpha)
    if alpha <= 0.0 return c_bg end
    if alpha >= 1.0 return c_fg end
    var r0 = (c_bg >> 16) & 0xFF
    var g0 = (c_bg >> 8) & 0xFF
    var b0 = c_bg & 0xFF
    var r1 = (c_fg >> 16) & 0xFF
    var g1 = (c_fg >> 8) & 0xFF
    var b1 = c_fg & 0xFF
    var r = int(r0 + (r1 - r0) * alpha)
    var g = int(g0 + (g1 - g0) * alpha)
    var b = int(b0 + (b1 - b0) * alpha)
    return (r << 16) | (g << 8) | b
  end

  # Berechnet den Abblend-Gradienten basierend auf der Distanz zum Text-Rahmen
  def get_shadow_factor(x, y, bx0, by0, bx1, by1)
    var dx = 0
    if x < bx0
      dx = bx0 - x
    elif x > bx1
      dx = x - bx1
    end

    var dy = 0
    if y < by0
      dy = by0 - y
    elif y > by1
      dy = y - by1
    end

    var d2 = dx * dx + dy * dy
    if d2 == 0
      return 0.18  # Direkt am/hinter dem Text: ~82% dunkler
    elif d2 <= 1
      return 0.35  # 1 Pixel Abstand: ~65% dunkler
    elif d2 <= 4
      return 0.65  # 2 Pixel Abstand: ~35% dunkler
    elif d2 <= 9
      return 0.88  # 3 Pixel Abstand: ~12% dunkler
    else
      return 1.0   # Volle Originalfarbe
    end
  end

  # Berechnet die Hintergrundfarbe des Wassers inklusive Wellenkante und Textschatten
  def get_water_color(x, y, surf_y, height, bx0, by0, bx1, by1, cfg_shadow)
    if y < surf_y || y >= height return 0x000000 end
    var is_surface = (y == surf_y)
    var c = is_surface ? 0x4DD0E1 : 0x0288D1

    if cfg_shadow && (x >= (bx0 - 3)) && (x <= (bx1 + 3)) && (y >= (by0 - 3)) && (y <= (by1 + 3))
      var factor = self.get_shadow_factor(x, y, bx0, by0, bx1, by1)
      if factor < 1.0
        if is_surface
          c = self.dim_color(c, 0.70 + (factor * 0.30))
        else
          c = self.dim_color(c, factor)
        end
      end
    end
    return c
  end

  def draw_big_text(txt, width, height, col)
    var n = size(txt)
    if n == 0 return end

    var char_w = 5
    var gap = 1
    var total_w = n * char_w + (n - 1) * gap
    var start_x = int((width - total_w) / 2)
    var start_y = int((height - 10) / 2)

    var cur_x = start_x
    for i: 0 .. (n - 1)
      var ch = txt[i]
      var glyph = nil

      if self.big_font.contains(ch)
        glyph = self.big_font[ch]
      elif self.big_font.contains(str(ch))
        glyph = self.big_font[str(ch)]
      end

      if glyph != nil
        for r: 0 .. 9
          var row_val = glyph[r]
          for c: 0 .. 4
            if (row_val & (1 << (4 - c))) != 0
              pixel(cur_x + c, start_y + r, col)
            end
          end
        end
      end
      cur_x = cur_x + char_w + gap
    end
  end

  def get_text_coords(txt, width, height, cfg_x, cfg_y)
    var w = 0
    try
      w = text_width(txt)
    except ..
      w = size(txt) * 4
    end

    var x = 2
    if cfg_x == "center"
      x = (width - w) / 2
    elif cfg_x == "right"
      x = width - w - 2
    else
      x = 2
    end

    var y = 6
    if cfg_y == "middle"
      y = 11
    elif cfg_y == "bottom"
      y = 15
    else
      y = 6
    end

    return [int(x), int(y)]
  end

  def draw()
    var width = 52
    var height = 16

    # Konfigurationswerte aus dem AWTRIX Store laden
    var cfg_speed = 3
    var cfg_big = false
    var cfg_shadow = true
    var cfg_pos_x = "left"
    var cfg_pos_y = "top"

    try
      if store.get("speed") != nil       cfg_speed = int(store.get("speed")) end
      if store.get("pos_x") != nil       cfg_pos_x = str(store.get("pos_x")) end
      if store.get("pos_y") != nil       cfg_pos_y = str(store.get("pos_y")) end
      if store.get("big_text") != nil
        var b = store.get("big_text")
        cfg_big = (b == "yes" || b == "Yes" || b == "true" || b == true || b == 1 || b == "1")
      end
      if store.get("text_shadow") != nil
        var s = store.get("text_shadow")
        cfg_shadow = (s == "yes" || s == "Yes" || s == "true" || s == true || s == 1 || s == "1")
      end
    except ..
    end

    # MQTT-Topic Wechsel im laufenden Betrieb
    var active_topic = self.get_topic()
    if self.current_topic != active_topic
      if self.current_topic != nil && size(self.current_topic) > 0
        try
          mqtt.unsubscribe(self.current_topic)
        except ..
        end
      end
      self.current_topic = active_topic
      if self.current_topic != nil && size(self.current_topic) > 0
        mqtt.subscribe(self.current_topic, / topic, payload -> self.on_mqtt(payload))
      end
    end

    clear()

    if self.should_hide()
      try
        rotation.next()
      except ..
      end
      return
    end

    # Kontinuierliche Phasenverschiebung für weiche Wellenbewegung
    var phase_step = real(cfg_speed) * 0.025
    self.wave_phase += phase_step
    if self.wave_phase > 62.83
      self.wave_phase -= 62.83
    end

    var has_data = (self.level != nil)
    var fill = has_data ? self.level : 15.0
    var water_height_px = int((fill / 100.0) * height)
    var base_y = height - water_height_px

    # Text und Bounding-Box für den Schatten vorausberechnen
    var txt = has_data ? (str(int(self.level)) + "%") : "--%"
    var col = has_data ? 0xFFFFFF : 0xFFA726

    var bx0 = 0
    var bx1 = 0
    var by0 = 0
    var by1 = 0
    var pos = nil

    if cfg_big
      var n = size(txt)
      var total_w = n * 5 + (n - 1)
      bx0 = int((width - total_w) / 2)
      bx1 = bx0 + total_w - 1
      by0 = int((height - 10) / 2)
      by1 = by0 + 9
    else
      pos = self.get_text_coords(txt, width, height, cfg_pos_x, cfg_pos_y)
      bx0 = pos[0]
      var w = 0
      try
        w = text_width(txt)
      except ..
        w = size(txt) * 4
      end
      bx1 = bx0 + w - 1
      by0 = pos[1] - 5
      by1 = pos[1]
    end

    # 1. Vollbild-Wasserfläche mit 1-Pixel-Welle nur nach oben (-1 oder 0)
    for x: 0 .. (width - 1)
      var wave_val = math.sin((x * 0.22) + self.wave_phase)
      var wave_offset = (wave_val > 0.0) ? -1 : 0
      var surf_y = base_y + wave_offset

      if surf_y < 0       surf_y = 0      end
      if surf_y > height  surf_y = height end

      if surf_y < height
        for y: surf_y .. (height - 1)
          pixel(x, y, self.get_water_color(x, y, surf_y, height, bx0, by0, bx1, by1, cfg_shadow))
        end
      end
    end

    # 2. Aufsteigende Luftbläschen mit konstanter Zyklusdauer (unabhängig vom Wasserstand)
    var speed_factor = 0.05 + (real(cfg_speed) * 0.02)
    for b: self.bubbles
      b[1] = b[1] - (b[2] * speed_factor)

      var cur_bx = int(b[0] + math.sin(b[1] * 1.5 + b[3]) * 0.6 + 0.5)
      if cur_bx < 1 cur_bx = 1 end
      if cur_bx >= (width - 1) cur_bx = width - 2 end

      var wave_val_b = math.sin((cur_bx * 0.22) + self.wave_phase)
      var surf_y_b = base_y + ((wave_val_b > 0.0) ? -1 : 0)
      if surf_y_b < 0       surf_y_b = 0      end
      if surf_y_b > height  surf_y_b = height end

      # Beim Erreichen der Wellenoberfläche: Fester Zyklusabstand (height = 16),
      # damit die Frequenz und Blasenzahl bei niedrigem Wasserstand exakt gleich bleibt!
      if b[1] <= real(surf_y_b)
        b[1] = real(surf_y_b + height) + (real(int(math.rand() % 20)) * 0.1)
        b[0] = real(int(math.rand() % (width - 4)) + 2)
        b[3] = real(int(math.rand() % 628)) * 0.01
      end

      # Bläschen nur rendern, wenn es sich im Wasser (zwischen Boden und Wellenkante) befindet
      if b[1] >= real(surf_y_b) && b[1] < real(height)
        var y0 = int(b[1])
        var frac = b[1] - real(y0)

        # Subpixel: Obere Zeile (y0)
        if y0 >= surf_y_b && y0 < height
          var bg0 = self.get_water_color(cur_bx, y0, surf_y_b, height, bx0, by0, bx1, by1, cfg_shadow)
          var b_col0 = 0xE0F7FA
          if cfg_shadow && cur_bx >= (bx0 - 3) && cur_bx <= (bx1 + 3) && y0 >= (by0 - 3) && y0 <= (by1 + 3)
            var factor = self.get_shadow_factor(cur_bx, y0, bx0, by0, bx1, by1)
            if factor < 1.0
              b_col0 = self.dim_color(b_col0, 0.50 + (factor * 0.50))
            end
          end
          var col0 = self.blend_colors(bg0, b_col0, 1.0 - frac)
          pixel(cur_bx, y0, col0)
        end

        # Subpixel: Untere Zeile (y1)
        var y1 = y0 + 1
        if y1 >= surf_y_b && y1 < height && frac > 0.04
          var bg1 = self.get_water_color(cur_bx, y1, surf_y_b, height, bx0, by0, bx1, by1, cfg_shadow)
          var b_col1 = 0xE0F7FA
          if cfg_shadow && cur_bx >= (bx0 - 3) && cur_bx <= (bx1 + 3) && y1 >= (by0 - 3) && y1 <= (by1 + 3)
            var factor = self.get_shadow_factor(cur_bx, y1, bx0, by0, bx1, by1)
            if factor < 1.0
              b_col1 = self.dim_color(b_col1, 0.50 + (factor * 0.50))
            end
          end
          var col1 = self.blend_colors(bg1, b_col1, frac)
          pixel(cur_bx, y1, col1)
        end
      end
    end

    # 3. Textdarstellung auf abgedunkeltem Hintergrund
    if cfg_big
      self.draw_big_text(txt, width, height, col)
    else
      text(pos[0], pos[1], txt, col)
    end
  end
end

return WaterLevel()